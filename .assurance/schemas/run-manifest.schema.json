{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/assurance/run-manifest.schema.json",
  "title": "Delivery run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "specification", "process_contract", "computed_tier", "approved_tier", "status", "started_at", "completed_at", "stages", "artifacts", "approvals"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "pattern": "^RUN-[A-Z0-9-]{8,}$"},
    "specification": {
      "type": "object", "additionalProperties": false,
      "required": ["work_item", "source", "digest"],
      "properties": {
        "work_item": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "digest": {"$ref": "#/definitions/sha256"}
      }
    },
    "process_contract": {"$ref": "#/definitions/versioned_digest"},
    "computed_tier": {"$ref": "#/definitions/tier"},
    "approved_tier": {"$ref": "#/definitions/tier"},
    "status": {"enum": ["running", "awaiting_approval", "succeeded", "failed", "blocked", "cancelled"]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": ["string", "null"], "format": "date-time"},
    "base_revision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "stages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["stage", "runner", "model", "started_at", "completed_at", "duration_seconds", "cost", "attempts", "outcome"],
        "properties": {
          "stage": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
          "runner": {
            "type": "object", "additionalProperties": false,
            "required": ["identity", "kind", "context_id"],
            "properties": {
              "identity": {"type": "string", "minLength": 1},
              "kind": {"enum": ["human", "automated_service", "agent"]},
              "context_id": {"type": "string", "minLength": 1}
            }
          },
          "model": {"type": "string", "minLength": 1},
          "started_at": {"type": "string", "format": "date-time"},
          "completed_at": {"type": ["string", "null"], "format": "date-time"},
          "duration_seconds": {"type": "number", "minimum": 0},
          "cost": {"$ref": "#/definitions/money"},
          "attempts": {"type": "integer", "minimum": 1},
          "outcome": {"enum": ["pass", "fail", "blocked", "not_run", "not_required"]}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "uri", "digest"],
        "properties": {
          "type": {"enum": ["work_item", "verification_result", "review_record", "waiver", "agent_effect_manifest", "pull_request", "other"]},
          "uri": {"type": "string", "minLength": 1},
          "digest": {"$ref": "#/definitions/sha256"}
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["identity", "kind", "role", "tier", "decision", "decided_at", "reference"],
        "properties": {
          "identity": {"type": "string", "minLength": 1},
          "kind": {"const": "human"},
          "role": {"type": "string", "minLength": 1},
          "tier": {"$ref": "#/definitions/tier"},
          "decision": {"enum": ["approve", "reject"]},
          "decided_at": {"type": "string", "format": "date-time"},
          "reference": {"type": "string", "minLength": 1}
        }
      }
    },
    "totals": {
      "type": "object", "additionalProperties": false,
      "required": ["duration_seconds", "cost"],
      "properties": {
        "duration_seconds": {"type": "number", "minimum": 0},
        "cost": {"$ref": "#/definitions/money"}
      }
    }
  },
  "definitions": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "tier": {"enum": ["routine", "notable", "significant"]},
    "money": {
      "type": "object", "additionalProperties": false,
      "required": ["currency", "amount"],
      "properties": {
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "amount": {"type": "number", "minimum": 0}
      }
    },
    "versioned_digest": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "digest"],
      "properties": {"version": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/definitions/sha256"}}
    }
  }
}
