{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/assurance/gate-baseline.schema.json",
  "title": "CI evidence gate ratchet baseline",
  "description": "Known check findings recorded as baseline debt. In ratchet mode only findings missing from the base revision's baseline fail; the baseline may not grow without explicit approval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "created_at", "approved_by", "report_only_until", "findings"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "created_at": {"type": "string", "format": "date-time"},
    "approved_by": {"type": "string", "minLength": 1},
    "report_only_until": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "findings": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["fingerprint", "note"],
        "properties": {
          "fingerprint": {"type": "string", "pattern": "^check:[a-z-]+:.+$"},
          "note": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
