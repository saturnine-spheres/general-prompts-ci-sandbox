{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/assurance/triage-report.schema.json",
  "title": "Ticket triage report",
  "description": "Advisory triage of open tickets (design section 8.5). Judgments are deterministic and carry their reasons; ticket text is untrusted data.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "generated_at",
    "level",
    "tickets"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "report_id": {
      "type": "string",
      "pattern": "^TRI-[A-Z0-9-]{8,}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "level": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "tickets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "title",
          "acceptance_criteria",
          "estimated_size",
          "estimated_tier",
          "suitability",
          "score",
          "rank",
          "reasons",
          "questions"
        ],
        "properties": {
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "system",
              "project",
              "id",
              "url"
            ],
            "properties": {
              "system": {
                "enum": [
                  "github",
                  "gitlab",
                  "jira"
                ]
              },
              "project": {
                "type": "string",
                "minLength": 1
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "title": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "acceptance_criteria": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "present",
              "testable",
              "count"
            ],
            "properties": {
              "present": {
                "type": "boolean"
              },
              "testable": {
                "type": "boolean"
              },
              "count": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "estimated_size": {
            "enum": [
              "small",
              "medium",
              "large"
            ]
          },
          "estimated_tier": {
            "enum": [
              "routine",
              "notable",
              "significant"
            ]
          },
          "suitability": {
            "enum": [
              "ready",
              "needs-info",
              "not-suitable"
            ]
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "reasons": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "pickup": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decision",
              "reason"
            ],
            "properties": {
              "decision": {
                "enum": [
                  "start",
                  "skip",
                  "needs-human"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
