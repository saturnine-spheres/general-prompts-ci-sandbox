{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/assurance-hook.sh\" post-edit", "timeout": 900}]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/assurance-hook.sh\" pre-bash", "timeout": 900}]
      }
    ],
    "Stop": [
      {
        "hooks": [{"type": "command", "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/assurance-hook.sh\" stop", "timeout": 300}]
      }
    ]
  }
}
